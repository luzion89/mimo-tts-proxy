# 小米 MiMo 开放平台的 API Key(必填)
MIMO_API_KEY=

# 上游地址。官方集群默认即可;
# 若你的 token 是 Token-Plan 国内集群,改为 https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_BASE=https://api.xiaomimimo.com/v1

# MiMo TTS 模型
MIMO_TTS_MODEL=mimo-v2.5-tts

# 给 App 使用的访问密钥,防止公网陌生人盗刷余额。
# 无需手动填写:start.sh 首次启动时会在本地随机生成并写入本文件;之后可随时修改。
PROXY_API_KEY=

# 默认音色与格式(MiMo 支持: wav / mp3 / pcm / pcm16)
DEFAULT_VOICE=冰糖
DEFAULT_FORMAT=mp3

# OpenAI 音色名到 MiMo 音色的映射(可选,逗号分隔): alloy=冰糖,echo=茉莉
# 不映射的音色会原样透传给 MiMo,因此也可直接在 App 里填 MiMo 音色名
VOICE_MAP=

# 本地端口
PORT=8787
